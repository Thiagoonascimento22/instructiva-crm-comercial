{
  "name": "instructiva-projetos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Gestao de Projetos Instructiva - extracao automatica de tarefas a partir de documentos",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
